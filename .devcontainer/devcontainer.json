{
  "name": "EquityFlow AI Environment",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "njpwerner.autodocstring"
      ]
    }
  },
  "updateContentCommand": "pip install --upgrade pip && pip install -r requirements.txt",
  "postAttachCommand": "streamlit run app.py",
  "forwardPorts": [8501]
}
